# ── Diment & Associates + Fresh Start Academy — Environment Variables ──
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Vars prefixed VITE_ are bundled into the frontend and are public — never put secrets there.
# Everything else is server-only: read by api/*.ts (Vercel functions) and/or
# supabase/functions/*.ts (Supabase Edge Functions, set separately via `supabase secrets set`).

# ── Supabase (Academy project) ───────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co        # Same value as VITE_SUPABASE_URL — read by api/*.ts (no Vite bundling there)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key     # Server-side only — NEVER expose in frontend

# ── Resend (Email) ───────────────────────────────────────────────────
RESEND_API_KEY=re_xxx                                    # Server-side only
RESEND_FROM_EMAIL=noreply@dimentfirm.com                 # Verified sender domain
RESEND_NOTIFY_EMAIL=AMH@dimentfirm.com                   # Alayna — new registration notifications

# ── App Config ────────────────────────────────────────────────────────
VITE_APP_URL=https://dimentfirm.com                      # Canonical app URL (frontend)
APP_URL=https://dimentfirm.com                           # Same value — read by create-portal-session Edge Function

# ── NewChapter Lead Capture ───────────────────────────────────────────
VITE_NC_CAPTURE_URL=https://newchapter-production.up.railway.app/api/leads/website-capture

# ── Stripe (Academy billing — optional while in free beta) ──────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx                  # Frontend — safe to expose
STRIPE_SECRET_KEY=sk_test_xxx                            # Server-side only — used by create-checkout, create-portal-session, stripe-webhook
STRIPE_PRICE_ID=price_xxx                                # The recurring Price to subscribe new users to
DEFAULT_TRIAL_DAYS=14                                    # Optional — defaults to 14 in code if unset
STRIPE_WEBHOOK_SECRET=whsec_xxx                          # Signing secret for the Supabase Edge Function webhook endpoint
STRIPE_WEBHOOK_SECRET_VERCEL=whsec_xxx                   # Separate signing secret if also using the api/webhooks/stripe.ts fallback endpoint

# ── Session limits & cron ─────────────────────────────────────────────
VITE_MAX_CONCURRENT_SESSIONS=2                           # Frontend — optional, defaults to 2
MAX_CONCURRENT_SESSIONS=2                                # Edge Function (enforce-sessions) — optional, defaults to 2
CRON_SECRET=some-random-string                           # Optional — if set, daily-streak-check requires this as a Bearer token
