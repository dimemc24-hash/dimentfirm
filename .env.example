# ── Diment & Associates + Fresh Start Academy — Environment Variables ──
# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key   # Server-side only — NEVER expose in frontend

# ── Stripe ────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx                       # Public: safe for frontend
STRIPE_SECRET_KEY=sk_test_xxx                            # Server-side only
STRIPE_WEBHOOK_SECRET=whsec_xxx                          # Server-side only
STRIPE_PRICE_ID=price_xxx                                # Monthly subscription price ID

# ── App Config ────────────────────────────────────────────────────────
VITE_APP_URL=https://app.freshstartacademy.com           # Canonical app URL
VITE_MAX_CONCURRENT_SESSIONS=2                           # Max devices per user
VITE_DEFAULT_TRIAL_DAYS=14                               # Default trial length
